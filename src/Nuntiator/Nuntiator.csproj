<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    
    <!-- Package metadata -->
    <PackageId>Nuntiator</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nuntiator</Authors>
    <Description>A lightweight, high-performance MediatR alternative for .NET 10 providing commands, command handlers, pipeline middlewares, and automatic dependency injection.</Description>
    <PackageTags>mediatr;cqrs;command;handler;pipeline;middleware;dotnet10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
